{
  "manifest_version": 3,
  "name": "SelfyStudio · Telegram Ads Assistant",
  "version": "0.5.0",
  "description": "Локальные рекламные пакеты, проверка и заполнение формы Telegram Ads.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Открыть рекламный пакет"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://ads.telegram.org/*",
    "http://127.0.0.1/*"
  ],
  "key": ""
}
